msgid "Window Groups: mark or group a window"
msgstr "Группы окон: отметить окно или добавить его в группу"

msgid "Window Groups: previous tab"
msgstr "Группы окон: предыдущая вкладка"

msgid "Window Groups: next tab"
msgstr "Группы окон: следующая вкладка"

msgid "Window Groups: detach the current tab"
msgstr "Группы окон: отделить текущую вкладку"

msgid "Window Groups: ungroup windows"
msgstr "Группы окон: разгруппировать окна"

msgid "Window Groups"
msgstr "Группы окон"

#, qt-format
msgid "Window Groups — %1"
msgstr "Группы окон — %1"

msgid "Select another window and press the group shortcut again"
msgstr "Выберите другое окно и снова нажмите клавиши группировки"

msgid "Release to group windows"
msgstr "Отпустите кнопку, чтобы сгруппировать окна"

msgid "Drop here to group windows"
msgstr "Перетащите окно сюда для группировки"

msgid "Close Window"
msgstr "Закрыть окно"

msgid "Detach Window"
msgstr "Отделить окно"

msgid "Ungroup Windows"
msgstr "Разгруппировать окна"
